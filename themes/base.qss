/* Base stylesheet. @tokens@ are replaced from the theme JSON ("colors" + font_family, font_size, font_size_big). */
* { font-family: @font_family@; font-size: @font_size@pt; }
QWidget { background: @bg@; color: @text@; selection-background-color: @selection@; selection-color: @selection_text@; }
QMainWindow, QDialog { background: @bg@; }
QLabel { background: transparent; }
QFrame#HeaderBar { background: @header_bg@; border-bottom: 2px solid @accent@; }
QLabel#Brand { color: @accent@; font-weight: bold; font-size: @font_size_big@pt; }
QLabel#Clock { color: @accent@; font-weight: bold; }
QLabel#Dim, QLabel#StatLabel { color: @text_dim@; }
QLabel#StatLabel { font-size: 8pt; }
QLabel#StatValue { color: @accent@; font-size: 17pt; font-weight: bold; }
QFrame#StatStrip { background: @panel@; border-bottom: 1px solid @border@; }
QFrame#StatTile { background: @panel_alt@; border: 1px solid @border@; border-left: 3px solid @accent@; }
QFrame#Panel { background: @panel@; border: 1px solid @border@; }
QLabel#PanelTitle { background: @header_bg@; color: @accent@; font-weight: bold; padding: 3px 8px; border-bottom: 1px solid @border@; }
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextBrowser, QTextEdit { background: @input_bg@; border: 1px solid @border@; padding: 3px 6px; }
QLineEdit:focus, QComboBox:focus { border: 1px solid @accent@; }
QLineEdit#CommandBar { color: @accent@; font-weight: bold; border: 1px solid @accent@; padding: 5px 8px; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView { background: @panel@; border: 1px solid @accent@; selection-background-color: @accent@; selection-color: @accent_text@; }
QPushButton { background: @panel_alt@; border: 1px solid @border@; padding: 5px 12px; color: @text@; }
QPushButton:hover { border: 1px solid @accent@; color: @accent@; }
QPushButton:disabled { color: @text_dim@; border: 1px solid @border@; }
QPushButton[accent="true"] { background: @accent@; color: @accent_text@; border: 1px solid @accent@; font-weight: bold; }
QPushButton[accent="true"]:hover { background: @accent_hover@; color: @accent_text@; }
QPushButton[accent="true"]:disabled { background: @border@; color: @text_dim@; }
QCheckBox { background: transparent; spacing: 6px; }
QTableView, QTableWidget { background: @panel@; alternate-background-color: @panel_alt@; gridline-color: @border@; border: 1px solid @border@; }
QTableView::item:selected { background: @selection@; color: @selection_text@; }
QHeaderView::section { background: @header_bg@; color: @accent@; border: none; border-right: 1px solid @border@; border-bottom: 1px solid @accent@; padding: 4px 6px; font-weight: bold; }
QTabWidget::pane { border: 1px solid @border@; top: -1px; }
QTabBar::tab { background: @panel@; color: @text_dim@; padding: 6px 18px; border: 1px solid @border@; border-bottom: none; margin-right: 1px; }
QTabBar::tab:selected { background: @accent@; color: @accent_text@; font-weight: bold; }
QTabBar::tab:hover:!selected { color: @accent@; }
QScrollBar:vertical { background: @bg@; width: 10px; margin: 0; }
QScrollBar:horizontal { background: @bg@; height: 10px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: @border@; min-height: 24px; min-width: 24px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: @accent@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QProgressBar { background: @panel@; border: none; max-height: 4px; text-align: center; color: transparent; }
QProgressBar::chunk { background: @accent@; }
QSplitter::handle { background: @border@; }
QStatusBar { background: @header_bg@; color: @text_dim@; border-top: 1px solid @border@; }
QStatusBar::item { border: none; }
QMenuBar { background: @header_bg@; }
QMenuBar::item:selected { background: @accent@; color: @accent_text@; }
QMenu { background: @panel@; border: 1px solid @accent@; }
QMenu::item { padding: 4px 24px; }
QMenu::item:selected { background: @accent@; color: @accent_text@; }
QToolTip { background: @panel@; color: @text@; border: 1px solid @accent@; }
